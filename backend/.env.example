# ============================================================
# 复制本文件为 .env 并按需填写：  copy .env.example .env
# .env 已被 .gitignore 忽略，不会被提交到代码仓库
# ============================================================

# AI 模式：mock（本地演示，不需要任何 Key） / real（真实大模型，第五阶段才需要）
AI_MODE=mock

# 多模态 AI 服务的 API Key（【绝不能】写进前端代码！）
# 仅 AI_MODE=real 时才会被使用；第一阶段留空即可
AI_API_KEY=

# OpenAI 兼容接口地址（默认阿里云百炼 DashScope 兼容模式，可换成其他兼容服务）
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼原生接口根地址（图像 / 语音 / 识别服务用，不带 /compatible-mode/v1）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# 聊天文本模型名称（real 模式使用）
AI_MODEL=qwen-plus

# 多模态视觉模型名称（图像识别专用，与文本模型分开配置）
# 注意：qwen-vl-max / qwen-vl-plus 已被阿里云下线（2026-10 实测 Model not exist），改用 qwen3-vl-plus
AI_VISION_MODEL=qwen3-vl-plus

# 设为 1 可强制 mock 模式（即使填了 Key 也不真正调用 AI），用于开发调试
MOCK_MODE=0

# ---------------- 知识库（RAG）----------------
# Embedding 提供方：fastembed（默认，本地 ONNX 中文语义模型，无需 torch / API Key，
#   首次运行经 hf-mirror.com 镜像下载到 backend/.models_cache，约 90MB）/ naive（伪向量兜底）
EMBEDDING_PROVIDER=fastembed
# fastembed 模型名（中文 bge-small-zh-v1.5，dim=512）
FASTEMBED_MODEL=BAAI/bge-small-zh-v1.5
# 检索时返回的最大资料条数
RETRIEVE_TOP_K=3
# 混合检索开关：1=向量+BM25 关键词 RRF 融合（默认） / 0=纯向量（对比测试用）
HYBRID_SEARCH=1
# 每路检索的候选数量（融合前）
RETRIEVE_CANDIDATES=10
# RRF 融合常数（经典值 60）
RRF_K=60
# BM25 候选最低分：低于此分的关键词命中视为噪音丢弃
BM25_MIN_SCORE=2.0
# 相似度阈值（cosine 距离，越小越相关；伪向量模式建议 0.85，真实模型下后端自动收紧到 0.6；
#   显式配置 ≤0.8 的值时对真实模型同样生效）
SIMILARITY_THRESHOLD=0.85
# 中文长文本切分：单块最大字数 / 相邻块重叠字数（按句子边界切分，不截断句子）
CHUNK_MAX_CHARS=260
CHUNK_OVERLAP_CHARS=40

# 上传图片大小上限（MB）
MAX_UPLOAD_MB=10

# ---------------- 创作工坊：产品效果图 ----------------
# 图片生成模式：demo（默认，本地带水印演示图，零成本）/ real（百炼 wan2.7-image 真实文生图）
IMAGE_MODE=demo
# 图片服务 Key（不填则复用上面的 AI_API_KEY）
IMAGE_API_KEY=
# 百炼原生 API 地址（wan2.7-image 走同步 multimodal-generation 接口，不要加 /compatible-mode/v1）
IMAGE_BASE_URL=https://dashscope.aliyuncs.com
# 万相模型名（wan2.7-image 为同步接口，单张 40~90s；旧 wanx2.1-t2i-* 已下线）
IMAGE_MODEL=wan2.7-image
# 同步生图超时秒数（3 张并行也要 1~2 分钟，前端轮询任务化获取结果）
IMAGE_SYNC_TIMEOUT_S=240
# 异步生图任务最长等待与轮询间隔（秒）
IMAGE_TASK_TIMEOUT_S=150
IMAGE_POLL_INTERVAL_S=2.5
# 出图尺寸（宽*高）与提案数量
IMAGE_SIZE=1024*1024
IMAGE_PROPOSAL_COUNT=3

# ---------------- 创作工坊：产品介绍视频（阶段三） ----------------
# 视频生成模式：demo（默认，本地 FFmpeg 合成带"演示视频"字幕卡的短片）/ real（预留）
VIDEO_MODE=demo
# 视频服务 Key（不填则复用上面的 AI_API_KEY）
VIDEO_API_KEY=
# 视频生成服务地址与模型名（real 模式预留，默认关闭）
VIDEO_BASE_URL=https://dashscope.aliyuncs.com
VIDEO_MODEL=wanx2.1-t2v-turbo
# 视频任务轮询间隔与单次生成最长等待（秒）
VIDEO_POLL_INTERVAL_S=3
VIDEO_TASK_TIMEOUT_S=300
# FFmpeg 路径：留空=依次尝试系统 PATH → imageio-ffmpeg 内置副本（pip 依赖，推荐）；
# 也可填本机完整版 ffmpeg.exe 的绝对路径（注意：Trae 自带精简版不可用）
FFMPEG_PATH=
# 单片时长（秒，10-15 之间）
VIDEO_DURATION_S=12

# ---------------- 创作工坊：AI 配音 TTS（阶段四） ----------------
# 语音服务 Key（不填则复用上面的 AI_API_KEY）；未配置时"生成配音"会明确报错，不会伪造音频
TTS_API_KEY=
# 百炼 Qwen-TTS 非实时语音合成（默认模型 qwen3-tts-flash，与万相同域名）
TTS_BASE_URL=https://dashscope.aliyuncs.com
TTS_MODEL=qwen3-tts-flash
# 单句合成超时（秒）
TTS_TIMEOUT_S=60
# 有声视频总时长上限（秒）
VIDEO_WITH_AUDIO_MAX_S=16

# ---------------- 语音识别 ASR ----------------
# 语音识别模型（与 AI_API_KEY 共用密钥）
ASR_MODEL=qwen3-asr-flash
